library(ggplot2)

year <- c(2016,2017,2018,2019,2020,
          2021,2022,2023,2024,2025)

sales <- c(150,170,200,240,260,
           300,340,390,430,480)

profit <- c(20,25,32,40,42,
            55,65,72,82,95)

customers <- c(1200,1500,1800,2200,2400,
               2800,3300,3800,4200,4700)

branches <- c(5,6,7,8,8,
              10,11,12,13,15)

data <- data.frame(
  Year = year,
  Sales = sales,
  Profit = profit,
  Customers = customers,
  Branches = branches
)

plot(
  data$Year,
  data$Sales,
  type = "o",
  pch = 19,
  col = "blue",
  xlab = "Year",
  ylab = "Sales",
  main = "Yearly Sales"
)

ggplot(data,
       aes(x = Sales,
           y = Profit,
           size = Customers,
           color = Branches)) +
  geom_point(alpha = 0.8) +
  labs(
    title = "Sales vs Profit",
    x = "Sales",
    y = "Profit",
    size = "Customers",
    color = "Branches"
  ) +
  theme_minimal()

correlation <- cor(data[,2:5])
print(correlation)

pairs(
  data[,2:5],
  main = "Scatter Plot Matrix"
)

if(cor(data$Branches,data$Sales) > 0 &
   cor(data$Branches,data$Profit) > 0)
{
  cat("Increase in branches is associated with higher sales and profits.")
}
else
{
  cat("No positive association found.")
}
