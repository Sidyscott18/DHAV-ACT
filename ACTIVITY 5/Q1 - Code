library(ggplot2)

data <- data.frame(
  City = c("Chennai","Bangalore","Hyderabad","Mumbai","Delhi",
           "Pune","Kolkata","Ahmedabad","Jaipur","Kochi"),
  Latitude = c(13.08,12.97,17.38,19.07,28.61,
               18.52,22.57,23.02,26.91,9.93),
  Longitude = c(80.27,77.59,78.48,72.87,77.21,
                73.85,88.36,72.57,75.79,76.26),
  Population = c(11,13,10,20,32,7,15,8,4,2)
)

ggplot(data,
       aes(x = Longitude,
           y = Latitude,
           size = Population,
           color = Population)) +
  geom_point(alpha = 0.8) +
  geom_text(aes(label = City), vjust = -1) +
  scale_color_gradient(low = "green", high = "red") +
  labs(
    title = "Geospatial Data Visualization",
    x = "Longitude",
    y = "Latitude",
    size = "Population",
    color = "Population"
  ) +
  theme_minimal()

highest <- data[which.max(data$Population), ]

print(highest)

cat("City with Highest Population:", highest$City)
